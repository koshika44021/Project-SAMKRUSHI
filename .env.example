# SAMKRUSHI — environment overview. Each app has its own .env.example:
#   apps/admin-web/.env.example   (Next.js; NEXT_PUBLIC_* is browser-visible)
#   apps/mobile/.env.example      (Expo;   EXPO_PUBLIC_* is bundled into the app)
#
# Rules (master spec §8):
# - Commit only *.example files. Real values live in local .env.local files,
#   EAS environment variables, the hosting provider, or Supabase secrets.
# - Never put service-role/secret keys, Razorpay key secret, webhook secrets,
#   R2 credentials or FCM/APNs keys in NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
# - Edge Function secrets are set with `pnpm exec supabase secrets set` (Phase 3+).

# Opt out of framework telemetry locally (CI sets these too).
NEXT_TELEMETRY_DISABLED=1
EXPO_NO_TELEMETRY=1
TURBO_TELEMETRY_DISABLED=1
