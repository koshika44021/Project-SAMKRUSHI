# apps/admin-web — copy to .env.local (never commit real values).
# Browser-exposed values MUST use the NEXT_PUBLIC_ prefix and must never be secrets.
APP_ENV=development

# Supabase (Phase 2+). The anon/publishable key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Used only in trusted server code.
SUPABASE_SECRET_KEY=
