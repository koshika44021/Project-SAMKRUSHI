# apps/mobile — copy to .env.local (never commit real values).
# EXPO_PUBLIC_* values are embedded in the app bundle: they must NEVER be secrets.
# No service-role, Razorpay secret, R2 or webhook secret may appear here.

# development | preview | production (EAS profiles set this automatically)
APP_VARIANT=development

# Store identity — founder decision; required for production builds.
ANDROID_APPLICATION_ID=
IOS_BUNDLE_IDENTIFIER=
APP_DISPLAY_NAME=
APP_SCHEME=

# EAS project link (from `eas init`), optional locally.
EAS_PROJECT_ID=
EAS_OWNER=

# Supabase (Phase 5+). Publishable key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
