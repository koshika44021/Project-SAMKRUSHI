{
  "name": "@samkrushi/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-agnostic Zod schemas, domain types, constants and formatters shared by admin-web, mobile and Supabase Edge Functions.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./access": "./src/access.ts",
    "./api": "./src/api.ts",
    "./catalog": "./src/catalog.ts",
    "./farmer": "./src/farmer.ts",
    "./money": "./src/money.ts",
    "./phone": "./src/phone.ts",
    "./quantity": "./src/quantity.ts",
    "./staff": "./src/staff.ts",
    "./supply": "./src/supply.ts",
    "./time": "./src/time.ts",
    "./database": "./src/database.types.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@samkrushi/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
