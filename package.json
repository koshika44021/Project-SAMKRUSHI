{
  "name": "samkrushi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on error",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:types:check": "node scripts/gen-db-types.mjs --check"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "3.2.0",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  }
}
