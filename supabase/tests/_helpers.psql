-- Shared pgTAP helpers. Included by each *.test.sql via \ir inside its own
-- transaction, so everything here is rolled back after the test file.
create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

-- Create an auth user, optionally with a staff profile and roles.
create function tests.create_user(
  p_label text,
  p_roles public.app_role[] default '{}',
  p_staff boolean default false,
  p_active boolean default true
) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
  v_role public.app_role;
begin
  insert into auth.users (id, email, aud, role)
  values (v_id, p_label || '@test.invalid', 'authenticated', 'authenticated');

  if p_staff then
    insert into public.staff_profiles (user_id, full_name, is_active, deactivated_at, deactivation_reason)
    values (
      v_id, 'Test ' || p_label, p_active,
      case when p_active then null else now() end,
      case when p_active then null else 'test deactivation' end
    );
  end if;

  foreach v_role in array p_roles loop
    insert into public.user_roles (user_id, role) values (v_id, v_role);
  end loop;
  return v_id;
end;
$$;

-- Switch the current transaction to an authenticated user / anon / service_role.
create function tests.authenticate_as(p_user_id uuid) returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated')::text, true);
  execute 'set local role authenticated';
end;
$$;

create function tests.authenticate_as_anon() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  execute 'set local role anon';
end;
$$;

create function tests.authenticate_as_service_role() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  execute 'set local role service_role';
end;
$$;

create function tests.clear_authentication() returns void
language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- Number of rows the given user can see in public.<table> (RLS applies).
create function tests.visible_rows(p_user_id uuid, p_table text) returns bigint
language plpgsql as $$
declare
  v_count bigint;
begin
  if p_user_id is null then
    perform tests.authenticate_as_anon();
  else
    perform tests.authenticate_as(p_user_id);
  end if;
  begin
    execute format('select count(*) from public.%I', p_table) into v_count;
  exception when insufficient_privilege then
    v_count := -1; -- no table privilege at all
  end;
  perform tests.clear_authentication();
  return v_count;
end;
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
