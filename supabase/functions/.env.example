# Edge Function environment for LOCAL serving (copy to supabase/functions/.env).
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by the runtime.
# Public base URL clients use for public product images (the runtime's internal
# SUPABASE_URL is not reachable by apps).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Comma-separated browser origins allowed by CORS (native apps need none).
ALLOWED_ORIGINS=
# Scheduled jobs: shared secret required in the x-cron-secret header (min 16 chars).
# DEV placeholder only; production value is set with `supabase secrets set`.
CRON_SECRET=dev-only-cron-secret-change-me
# Orphaned private object grace period in seconds (dev placeholder; SQL enforces >= 3600).
ORPHAN_GRACE_SECONDS=86400
